---
export interface Props {
  src: string;
  /** Hauteur de la zone de scroll en vh (ex: 300 = 3 × hauteur écran) */
  scrollHeight?: number;
  /** Texte affiché au début (avant scroll) */
  labelBefore?: string;
  /** Texte affiché à la fin (après ouverture) */
  labelAfter?: string;
}

const {
  src,
  scrollHeight = 300,
  labelBefore = "Découvrez le POD",
  labelAfter  = "Une cuisine outdoor architecturale",
} = Astro.props;
---

<section class="scroll-video-section" style={`--scroll-height: ${scrollHeight}vh`}>
  <!-- Zone sticky : occupe toujours 100vh pendant le scroll -->
  <div class="scroll-video-sticky">

    <!-- Vidéo muette, préchargée, non contrôlable par l'utilisateur -->
    <video
      id="scroll-video"
      class="scroll-video__video"
      src={src}
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>

    <!-- Overlay sombre pour lisibilité du texte -->
    <div class="scroll-video__overlay" id="scroll-video-overlay"></div>

    <!-- Indicateur de progression -->
    <div class="scroll-video__progress-bar" id="scroll-progress-bar"></div>

    <!-- Label "avant" — visible au départ, disparaît en scrollant -->
    <div class="scroll-video__label scroll-video__label--before" id="label-before">
      <span class="scroll-video__label-eyebrow">Le POD s'ouvre devant vous</span>
      <p class="scroll-video__label-text">{labelBefore}</p>
      <div class="scroll-video__scroll-hint">
        <span>Faites défiler</span>
        <div class="scroll-video__arrow">↓</div>
      </div>
    </div>

    <!-- Label "après" — apparaît quand l'animation est terminée -->
    <div class="scroll-video__label scroll-video__label--after" id="label-after">
      <span class="scroll-video__label-eyebrow">Jardicook</span>
      <p class="scroll-video__label-text">{labelAfter}</p>
      <a href="/produits" class="btn btn-primary">Découvrir le POD</a>
    </div>

  </div>
</section>

<script>
  function initScrollVideo() {
    const section     = document.querySelector('.scroll-video-section') as HTMLElement;
    const video       = document.getElementById('scroll-video')         as HTMLVideoElement;
    const overlay     = document.getElementById('scroll-video-overlay') as HTMLElement;
    const progressBar = document.getElementById('scroll-progress-bar') as HTMLElement;
    const labelBefore = document.getElementById('label-before')         as HTMLElement;
    const labelAfter  = document.getElementById('label-after')          as HTMLElement;

    if (!section || !video) return;

    video.preload = 'auto';
    video.pause();
    video.currentTime = 0;

    // Lerp state : targetProgress suit le scroll, smoothProgress suit avec inertie
    let targetProgress = 0;
    let smoothProgress = 0;
    const LERP = 0.10; // 0.05 = très doux, 0.15 = plus réactif

    let isVisible = false;
    const observer = new IntersectionObserver(
      (entries) => { isVisible = entries[0].isIntersecting; },
      { rootMargin: '200px' }
    );
    observer.observe(section);

    // Calcul du progress cible depuis le scroll (pas de RAF ici, juste mise à jour)
    function updateTarget() {
      const rect     = section.getBoundingClientRect();
      const total    = section.offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      targetProgress = Math.min(1, Math.max(0, scrolled / total));
    }

    function applyProgress(p: number) {
      // Scrub vidéo
      if (video.readyState >= 2 && video.duration) {
        video.currentTime = p * video.duration;
      }

      // Barre de progression
      progressBar.style.width = `${p * 100}%`;

      // Overlay
      overlay.style.opacity = String(Math.max(0.1, 0.55 - p * 0.35));

      // Label avant
      const beforeOp = Math.max(0, 1 - p * 4);
      labelBefore.style.opacity   = String(beforeOp);
      labelBefore.style.transform = `translateX(-50%) translateY(${p * -40}px)`;

      // Label après
      const afterOp = Math.max(0, (p - 0.75) * 4);
      labelAfter.style.opacity       = String(afterOp);
      labelAfter.style.transform     = `translateX(-50%) translateY(${(1 - afterOp) * 30}px)`;
      labelAfter.style.pointerEvents = afterOp > 0.5 ? 'auto' : 'none';
    }

    // Boucle RAF continue : lerp smoothProgress → targetProgress
    function loop() {
      requestAnimationFrame(loop);
      if (!isVisible) return;

      updateTarget();

      // Lerp
      smoothProgress += (targetProgress - smoothProgress) * LERP;

      // Évite les micro-updates inutiles
      if (Math.abs(smoothProgress - targetProgress) < 0.0005) {
        smoothProgress = targetProgress;
      }

      applyProgress(smoothProgress);
    }

    window.addEventListener('scroll', () => {}, { passive: true }); // passive hint
    loop();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollVideo);
  } else {
    initScrollVideo();
  }
</script>

<style>
  .scroll-video-section {
    /* Hauteur totale = zone de scroll */
    height: var(--scroll-height, 300vh);
    position: relative;
  }

  /* La partie sticky reste collée pendant tout le scroll */
  .scroll-video-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: var(--color-bg-dark);
  }

  /* Vidéo en fond plein écran */
  .scroll-video__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: contents;
    transform: translateZ(0); /* force GPU layer */
  }

  /* Overlay sombre */
  .scroll-video__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-bg-dark);
    opacity: 0.55;
    transition: opacity 0.05s linear;
    pointer-events: none;
  }

  /* Barre de progression fine en haut */
  .scroll-video__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--color-secondary);
    transition: width 0.05s linear;
    z-index: 10;
  }

  /* Labels */
  .scroll-video__label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--color-white);
    z-index: 5;
    pointer-events: none;
    transition: none; /* géré par JS */
    width: 90%;
    max-width: 680px;
  }

  .scroll-video__label--before {
    top: 50%;
    transform: translateX(-50%) translateY(-50%);
    opacity: 1;
  }

  .scroll-video__label--after {
    top: 50%;
    transform: translateX(-50%) translateY(calc(-50% + 30px));
    opacity: 0;
    pointer-events: none;
  }

  .scroll-video__label--after[style*="opacity: 1"],
  .scroll-video__label--after[style*="opacity:1"] {
    pointer-events: auto;
  }

  .scroll-video__label-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .scroll-video__label-text {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 2rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
  }

  /* Indicateur scroll */
  .scroll-video__scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .scroll-video__arrow {
    font-size: 1.4rem;
    animation: bounce 1.6s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(8px); }
  }

  /* Label "après" : le btn est cliquable */
  .scroll-video__label--after .btn {
    pointer-events: auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .scroll-video__label-text {
      font-size: clamp(1.4rem, 6vw, 2rem);
    }

    .scroll-video__video {
      object-fit: contain;
      object-position: center;
    }
  }
</style>
