---
import BaseLayout from '../../layouts/BaseLayout.astro';

const specs = [
  { label: 'Cuisson', value: 'Plancha pro + kamado céramique' },
  { label: 'Plan de travail', value: 'Sur-mesure (pierre, béton, inox)' },
  { label: 'Façades', value: 'Bois massif traité outdoor' },
  { label: 'Eau courante', value: 'Évier + robinet professionnel' },
  { label: 'Hotte aspirante', value: 'Intégrée haute puissance' },
  { label: 'Cave à boissons', value: 'Réfrigérateur intégré' },
  { label: 'Écran TV', value: 'Intégré (outdoor)' },
  { label: 'Éclairage LED', value: 'Architectural — toit + plan' },
  { label: 'Structure', value: 'Aluminium laqué vert signature' },
  { label: 'Personnalisation', value: '100% sur-mesure' },
  { label: 'Usage', value: 'Toutes saisons' },
];
---

<BaseLayout
  title="POD Big — Cuisine Extérieure Premium"
  description="Le POD Big de Jardicook : la cuisine extérieure ultime. Façades bois, plancha pro, kamado, TV, cave, éclairage architectural. 100% sur-mesure."
>

  <section class="pod-hero">
    <div class="pod-hero__image-col">
      <img
        src="/images/big pod config 1 .png"
        alt="POD Big — cuisine extérieure premium Jardicook"
        class="pod-hero__img"
      />
    </div>
    <div class="pod-hero__content">
      <nav class="breadcrumb"><a href="/produits">← Tous les POD</a></nav>
      <span class="pod-tag">Premium</span>
      <h1 class="pod-title">POD Big</h1>
      <p class="pod-tagline">Pour ceux qui ne font aucun compromis.</p>
      <p class="pod-desc">
        Le POD Big est la version ultime de la cuisine extérieure Jardicook. Façades en bois
        massif traité, plancha professionnelle, kamado céramique, écran TV, éclairage
        architectural sur toit et plan de travail — une installation qui transforme
        radicalement votre espace outdoor.
      </p>
      <div class="pod-actions">
        <a href="/configurateur" class="btn btn-primary">Configurer mon POD</a>
        <a href="/contact" class="btn btn-outline-dark">Demander un devis</a>
        <a href="/galerie" class="btn btn-outline-dark">Voir des réalisations</a>
      </div>
    </div>
  </section>

  <!-- Points forts -->
  <section class="pod-highlights">
    <div class="container">
      <h2 class="section-title">Ce qui le distingue</h2>
      <div class="highlights-grid">
        <div class="highlight">
          <span class="highlight__icon">🪵</span>
          <h3>Façades bois massif</h3>
          <p>Bois traité pour un usage outdoor intensif, insensible aux variations de température et à l'humidité.</p>
        </div>
        <div class="highlight">
          <span class="highlight__icon">🔥</span>
          <h3>Double cuisson pro</h3>
          <p>Plancha professionnelle et kamado céramique pour maîtriser toutes les techniques : saisir, fumer, rôtir.</p>
        </div>
        <div class="highlight">
          <span class="highlight__icon">💡</span>
          <h3>Éclairage architectural</h3>
          <p>LED intégrés sur le pourtour du toit et sous le plan de travail — une ambiance soignée du coucher du soleil à minuit.</p>
        </div>
        <div class="highlight">
          <span class="highlight__icon">🎨</span>
          <h3>100% sur-mesure</h3>
          <p>Dimensions, couleur de structure, matériaux, équipements : chaque POD Big est unique et conçu spécifiquement pour votre projet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs -->
  <section class="pod-specs">
    <div class="container pod-specs__inner">
      <div>
        <h2 class="section-title">Équipements & finitions</h2>
        <p class="pod-specs__intro">Le POD Big est entièrement personnalisable. Cette liste représente la configuration de référence — tout peut être adapté, ajouté ou modifié selon votre projet.</p>
        <ul class="specs-list">
          {specs.map(s => (
            <li class="specs-item">
              <span class="specs-label">{s.label}</span>
              <span class="specs-value">{s.value}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="cta-box">
        <div class="cta-box__badge">⭐ Configuration Premium</div>
        <h3>Démarrer votre projet</h3>
        <p>Nos architectes-cuisinistes étudient votre espace et vous proposent un projet 3D personnalisé sous 48h.</p>
        <a href="/configurateur" class="btn btn-primary" style="width:100%;text-align:center;display:block;">Configurer mon POD</a>
        <a href="/contact" class="btn btn-outline-dark" style="width:100%;text-align:center;display:block;margin-top:0.5rem;">Demander un devis</a>
        <div class="cta-box__nav">
          <a href="/produits/pod-mid" class="btn-nav">← POD Mid</a>
          <a href="/produits" class="btn-nav">Catalogue →</a>
        </div>
        <a href="/produits" class="cta-box__back">← Retour au catalogue</a>
      </aside>
    </div>
  </section>

</BaseLayout>

<style>
  .pod-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    background-color: var(--color-bg);
  }

  .pod-hero__image-col {
    background-color: #e8ede0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .pod-hero__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .pod-hero__image-col:hover .pod-hero__img { transform: scale(1.03); }

  .pod-hero__content { padding: var(--space-xl) var(--space-lg); display: flex; flex-direction: column; justify-content: center; gap: var(--space-sm); }

  .breadcrumb a { font-size: 0.85rem; color: var(--color-text-light); transition: color var(--transition); }
  .breadcrumb a:hover { color: var(--color-accent); }

  .pod-tag {
    display: inline-block;
    background-color: var(--color-secondary);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-xl);
    align-self: flex-start;
  }

  .pod-title { font-size: clamp(2.2rem, 4vw, 3.5rem); color: var(--color-primary); line-height: 1.1; }
  .pod-tagline { font-style: italic; color: var(--color-secondary); font-size: 1.1rem; }
  .pod-desc { color: var(--color-text-light); line-height: 1.75; max-width: 480px; }
  .pod-actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-xs); }

  .btn-outline-dark {
    display: inline-block; padding: 0.85rem 2rem; border-radius: var(--radius-xl);
    font-size: 0.95rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    border: 2px solid var(--color-primary); color: var(--color-primary); background: transparent;
    transition: all var(--transition); cursor: pointer;
  }
  .btn-outline-dark:hover { background-color: var(--color-primary); color: var(--color-chalk); }

  /* Highlights */
  .pod-highlights { padding-block: var(--space-xl); background-color: var(--color-white, #fff); }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .highlight { padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .highlight__icon { font-size: 1.8rem; display: block; margin-bottom: var(--space-sm); }
  .highlight h3 { font-size: 1rem; color: var(--color-primary); margin-bottom: 0.5rem; }
  .highlight p { font-size: 0.88rem; color: var(--color-text-light); line-height: 1.6; }

  /* Specs */
  .pod-specs { padding-block: var(--space-xl); background-color: var(--color-bg); }
  .pod-specs__inner { display: grid; grid-template-columns: 1fr 360px; gap: var(--space-lg); align-items: start; }
  .pod-specs__intro { color: var(--color-text-light); line-height: 1.7; margin-block: var(--space-sm) var(--space-md); }
  .specs-list { border-top: 1px solid var(--color-border); }
  .specs-item { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
  .specs-label { color: var(--color-text-light); }
  .specs-value { font-weight: 600; color: var(--color-primary); text-align: right; max-width: 55%; }

  .cta-box { background-color: var(--color-white, #fff); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); position: sticky; top: 100px; box-shadow: 0 4px 24px rgba(44,32,16,0.07); }

  .cta-box__badge { background-color: var(--color-secondary); color: var(--color-primary); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.8rem; border-radius: var(--radius-xl); align-self: flex-start; }
  .cta-box h3 { font-size: 1.2rem; color: var(--color-primary); }
  .cta-box p { font-size: 0.9rem; color: var(--color-text-light); line-height: 1.6; }

  .cta-box__nav { border-top: 1px solid var(--color-border); padding-top: var(--space-sm); display: flex; justify-content: space-between; }
  .btn-nav { font-size: 0.85rem; font-weight: 700; color: var(--color-accent); transition: color var(--transition); }
  .btn-nav:hover { color: var(--color-primary); }
  .cta-box__back { font-size: 0.85rem; color: var(--color-text-light); text-align: center; transition: color var(--transition); }
  .cta-box__back:hover { color: var(--color-primary); }

  @media (max-width: 1024px) { .highlights-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .pod-hero, .pod-specs__inner { grid-template-columns: 1fr; }
    .pod-hero__image-col { height: 320px; }
    .pod-hero__content { padding: var(--space-lg) var(--space-md); }
    .cta-box { position: static; }
  }
  @media (max-width: 600px) { .highlights-grid { grid-template-columns: 1fr; } }
</style>
