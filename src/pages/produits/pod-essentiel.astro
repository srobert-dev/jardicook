---
import BaseLayout from '../../layouts/BaseLayout.astro';

const specs = [
  { label: 'Cuisson', value: 'Plancha haute performance + brûleurs gaz' },
  { label: 'Plan de travail', value: 'Pierre naturelle ou granit' },
  { label: 'Rangements', value: 'Armoires inox intégrées' },
  { label: 'Éclairage', value: 'En option' },
  { label: 'Eau courante', value: 'En option' },
  { label: 'Structure', value: 'Acier traité laqué' },
  { label: 'Dimensions', value: 'Sur-mesure selon votre espace' },
  { label: 'Usage', value: 'Toutes saisons' },
];

const points = [
  { titre: 'Format compact', texte: 'Conçu pour les terrasses et jardins de taille intermédiaire, le POD Essentiel s\'intègre sans effort dans votre espace sans jamais le dominer.' },
  { titre: 'Cuisson maîtrisée', texte: 'Plancha professionnelle et brûleurs gaz haute puissance pour saisir, mijoter et griller avec précision, même par grand vent.' },
  { titre: 'Pierre naturelle', texte: 'Plan de travail en pierre naturelle ou granit : une matière noble, résistante aux chocs thermiques et aux intempéries.' },
  { titre: 'Évolutif', texte: 'Le POD Essentiel est pensé pour évoluer. Eau courante et éclairage peuvent être ajoutés à tout moment selon vos besoins.' },
];
---

<BaseLayout
  title="POD Essentiel — Cuisine Extérieure Compacte"
  description="Le POD Essentiel de Jardicook : cuisine extérieure compacte et élégante. Cuisson haute performance, plan de travail en pierre, rangements intégrés. Toutes saisons."
>

  <!-- HERO -->
  <section class="pod-hero">
    <div class="pod-hero__visual" aria-hidden="true">
      <div class="pod-hero__image"></div>
    </div>
    <div class="pod-hero__content">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/produits">← Tous les POD</a>
      </nav>
      <span class="pod-hero__tag">Compact</span>
      <h1 class="pod-hero__title">POD Essentiel</h1>
      <p class="pod-hero__tagline">L'essentiel, sans compromis sur l'élégance.</p>
      <p class="pod-hero__desc">
        L'introduction idéale à l'univers Jardicook. Le POD Essentiel intègre tout ce qui est
        nécessaire pour une cuisine outdoor performante dans un format sobre et adaptable,
        pensé pour durer.
      </p>
      <div class="pod-hero__actions">
        <a href="/contact" class="btn btn-primary">Demander un devis</a>
        <a href="/galerie" class="btn btn-outline">Voir des réalisations</a>
      </div>
    </div>
  </section>

  <!-- POINTS FORTS -->
  <section class="pod-points">
    <div class="container">
      <h2 class="section-title">Ce qui le rend unique</h2>
      <div class="pod-points__grid">
        {points.map(p => (
          <div class="pod-point">
            <div class="pod-point__dot" aria-hidden="true"></div>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="pod-gallery">
    <div class="container">
      <h2 class="section-title">Le POD Essentiel en situation</h2>
      <div class="pod-gallery__grid">
        <div class="pod-gallery__main" aria-hidden="true" style="background: linear-gradient(135deg, #14213D, #1E3A6E)"></div>
        <div class="pod-gallery__side">
          <div aria-hidden="true" style="background: linear-gradient(135deg, #1E3A6E, #2C5282)"></div>
          <div aria-hidden="true" style="background: linear-gradient(135deg, #0D1726, #14213D)"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPECS -->
  <section class="pod-specs">
    <div class="container pod-specs__inner">
      <div class="pod-specs__content">
        <h2 class="section-title">Équipements & finitions</h2>
        <p>Chaque POD Essentiel est configuré selon vos besoins. Les équipements listés constituent la base — tout peut être adapté lors de votre consultation.</p>
        <ul class="specs-list">
          {specs.map(s => (
            <li class="specs-item">
              <span class="specs-label">{s.label}</span>
              <span class="specs-value">{s.value}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="pod-specs__cta-box">
        <h3>Prêt à démarrer votre projet ?</h3>
        <p>Nos conseillers étudient gratuitement votre espace et vous proposent une configuration personnalisée.</p>
        <a href="/contact" class="btn btn-primary" style="width:100%; text-align:center;">Demander un devis gratuit</a>
        <a href="/produits" class="pod-specs__back">← Retour au catalogue</a>
        <div class="pod-specs__nav">
          <span>Configuration suivante</span>
          <a href="/produits/pod-signature" class="btn btn-outline pod-specs__nav-btn">POD Signature →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .pod-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 75vh;
  }

  .pod-hero__image {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #0D1726 0%, #14213D 50%, #1E3A6E 100%);
  }

  .pod-hero__content {
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    background-color: var(--color-bg);
  }

  .breadcrumb a {
    font-size: 0.85rem;
    color: var(--color-text-light);
    transition: color var(--transition);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .pod-hero__tag {
    display: inline-block;
    background-color: var(--color-secondary);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-xl);
    align-self: flex-start;
  }

  .pod-hero__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--color-primary);
    line-height: 1.1;
  }

  .pod-hero__tagline {
    font-style: italic;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  .pod-hero__desc {
    color: var(--color-text-light);
    line-height: 1.75;
    max-width: 480px;
  }

  .pod-hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .btn-outline:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  /* ---- Points forts ---- */
  .pod-points {
    padding-block: var(--space-xl);
    background-color: var(--color-white);
  }

  .pod-points__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .pod-point {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    position: relative;
  }

  .pod-point__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .pod-point h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .pod-point p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  /* ---- Galerie ---- */
  .pod-gallery {
    padding-block: var(--space-xl);
  }

  .pod-gallery__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 420px;
    gap: 8px;
    margin-top: var(--space-md);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .pod-gallery__main {
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }

  .pod-gallery__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }

  .pod-gallery__side > div {
    border-radius: 0;
  }

  .pod-gallery__side > div:last-child {
    border-radius: 0 0 var(--radius-md) 0;
  }

  /* ---- Specs ---- */
  .pod-specs {
    padding-block: var(--space-xl);
    background-color: var(--color-white);
  }

  .pod-specs__inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-lg);
    align-items: start;
  }

  .pod-specs__content > p {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .specs-list {
    border-top: 1px solid var(--color-border);
  }

  .specs-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .specs-label {
    color: var(--color-text-light);
    font-weight: 500;
  }

  .specs-value {
    font-weight: 600;
    color: var(--color-primary);
    text-align: right;
    max-width: 55%;
  }

  .pod-specs__cta-box {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    position: sticky;
    top: 100px;
  }

  .pod-specs__cta-box h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
  }

  .pod-specs__cta-box p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .pod-specs__back {
    font-size: 0.85rem;
    color: var(--color-text-light);
    text-align: center;
    transition: color var(--transition);
  }

  .pod-specs__back:hover {
    color: var(--color-primary);
  }

  .pod-specs__nav {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pod-specs__nav span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .pod-specs__nav-btn {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-align: center;
    font-size: 0.85rem;
    padding: 0.6rem 1rem;
  }

  .pod-specs__nav-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .pod-hero {
      grid-template-columns: 1fr;
    }

    .pod-hero__visual {
      height: 280px;
    }

    .pod-hero__content {
      padding: var(--space-lg) var(--space-md);
    }

    .pod-points__grid {
      grid-template-columns: 1fr;
    }

    .pod-gallery__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .pod-gallery__main {
      height: 260px;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .pod-gallery__side {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 160px;
    }

    .pod-specs__inner {
      grid-template-columns: 1fr;
    }

    .pod-specs__cta-box {
      position: static;
    }
  }
</style>
